---
import '../styles/global.css';
import hankenLatin from '../assets/fonts/hanken-latin.woff2?url';
import onestCyrillic from '../assets/fonts/onest-cyrillic.woff2?url';
import LocalePreference from '../components/LocalePreference.astro';
import { basePath, defaultLocale, getMessages, localePath, locales, type LocaleProps } from '../i18n';

type Props = LocaleProps;

const { locale } = Astro.props;
const { title, description } = getMessages(locale).site;
const absoluteLocaleUrl = (option: Props['locale']) => new URL(localePath(option), Astro.site ?? Astro.url);
---

<!doctype html>
<html lang={locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <LocalePreference locale={locale} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={absoluteLocaleUrl(locale)} />
    {locales.map((option) => <link rel="alternate" hreflang={option} href={absoluteLocaleUrl(option)} />)}
    <link rel="alternate" hreflang="x-default" href={absoluteLocaleUrl(defaultLocale)} />
    <meta name="theme-color" content="#00030E" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={`${basePath}/favicon.svg`} />
    <link rel="preload" href={hankenLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    {locale === 'ru' && <link rel="preload" href={onestCyrillic} as="font" type="font/woff2" crossorigin="anonymous" />}
    <noscript>
      <style is:inline>
        #sky, #app, .hud-top, .hud-bottom, .progress-rail, .modal, .skip-link { display: none !important; }
        body::before, body::after { display: none !important; }
        .nojs-fallback { display: block !important; }
        html, body { overflow: auto !important; background: #00030E !important; }
      </style>
    </noscript>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
