---
import { getMessages, type LocaleProps } from '../i18n';
import HomeCover from './HomeCover.astro';
import HomeHobbies from './HomeHobbies.astro';

type Props = LocaleProps;

const { locale } = Astro.props;
const { site } = getMessages(locale);
---

<div class="app" id="app">
  <div class="stage" id="stage" role="region" tabindex="-1" aria-label={site.atlasLabel} aria-describedby="sceneHint">
    <div class="drum" id="drum">
      <HomeCover locale={locale} />
      <HomeHobbies locale={locale} />
    </div>
    <p class="sr-only" id="sceneHint">{site.atlasHint}</p>
  </div>
</div>
