---
import { getMessages, type LocaleProps } from '../i18n';
import HomeHobbies from './HomeHobbies.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ResumeDownload from './ResumeDownload.astro';

type Props = LocaleProps;

const { locale } = Astro.props;
const { cover, site, profile, chapters, chapterSummaries } = getMessages(locale);
const chapterYears = ['2026', '2023', '2017', '2015', '2010', '2009', '2006'] as const;
const expectations = chapters.expectations;
const workPreferences = expectations.episodes['01'];
---

<div class="nojs-fallback" id="nojsFallback">
  <main class="nojs-wrap">
    <div class="nojs-actions">
      <LanguageSwitcher locale={locale} />
      <ResumeDownload locale={locale} />
    </div>
    <p class="nojs-kicker">{cover.introEyebrow}</p>
    <h1>{cover.introTitle.join(' ')}</h1>
    <p class="nojs-lead">{cover.introLead}</p>
    <p class="nojs-help">{cover.helpLabel}: {cover.helpLead}</p>
    <dl class="nojs-ai-tools">
      {profile.aiTools.map(({ label, names }) => (
        <div>
          <dt>{label}</dt>
          <dd>{names.join(', ')}</dd>
        </div>
      ))}
    </dl>
    <p class="nojs-meta">2006 — 2027 · {site.scope}</p>
    <div class="nojs-chapters">
      {chapterYears.map((year) => (
        <section>
          <h2>{year} · {chapters[year].title}</h2>
          <p class="nojs-period">{chapters[year].period}</p>
          <p>{chapterSummaries[year]}</p>
        </section>
      ))}
      <HomeHobbies locale={locale} fallback />
      <section>
        <h2>2027 · {expectations.title}</h2>
        <p class="nojs-period">{expectations.period}</p>
        <p>{workPreferences.text}</p>
        <ul class="nojs-list">
          {workPreferences.bullets.map((bullet) => <li>{bullet}</li>)}
        </ul>
      </section>
    </div>
    <p class="nojs-final">{site.noJsHint}</p>
  </main>
</div>

<style>
  .nojs-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    margin-bottom: 18px;
  }

  .nojs-ai-tools {
    display: grid;
    gap: 8px;
    margin: 16px 0 0;
    color: var(--text-soft);
    font-size: 14px;
  }

  .nojs-ai-tools dt { color: var(--lav-bright); }
  .nojs-ai-tools dd { margin: 0; }
</style>
