---
import { formatMessage, getMessages, type LocaleProps } from '../i18n';

type Props = LocaleProps;

const { locale } = Astro.props;
const { cover, atlas } = getMessages(locale);
---

<div class="stop stop-cover" data-cover="intro" data-index="0" role="group" aria-label={cover.introLabel}>
  <div class="cover-shell">
    <div class="cover-grid">
      <div class="cover-copy">
        <p class="cover-eyebrow">{cover.introEyebrow}</p>
        <h1 class="cover-title">
          {cover.introTitle.map((line, index, lines) => (
            <Fragment>{index > 0 && ' '}<span
              class:list={['title-line', { 'title-accent': index === lines.length - 1 }]}
            >{line}</span></Fragment>
          ))}
        </h1>
        <p class="cover-lead">{cover.introLead}</p>
        <div class="cover-actions">
          <button class="contact-cover-btn" type="button" data-open-contact>{cover.discuss} <span aria-hidden="true">↗</span></button>
          <span class="secondary-note"><span class="scroll-line" aria-hidden="true"></span>{cover.scroll}</span>
        </div>
      </div>
      <div class="cover-visual">
        <div class="skills-card" data-anim-host="skills">
          <span class="sr-only fig-number">{formatMessage(atlas.figureNumber, { number: '00' })}</span>
          <div class="skills-stage" data-skills-stage role="img" aria-label={cover.skillsLabel}>
            <canvas class="skills-canvas" data-skills-canvas aria-hidden="true"></canvas>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="stop stop-cover is-hidden" data-cover="help" data-index="1" role="group" aria-label={cover.helpLabel}>
  <div class="cover-shell">
    <div class="cover-grid">
      <div class="cover-copy">
        <p class="cover-eyebrow">{cover.helpEyebrow}</p>
        <h2 class="cover-title">
          {cover.helpTitle.map((line, index, lines) => (
            <Fragment>{index > 0 && ' '}<span
              class:list={['title-line', { 'title-accent': index === lines.length - 1 }]}
            >{line}</span></Fragment>
          ))}
        </h2>
        <p class="cover-lead">{cover.helpLead}</p>
        <div class="cover-actions">
          <span class="secondary-note"><span class="scroll-line" aria-hidden="true"></span>{cover.scroll}</span>
        </div>
      </div>
      <div class="cover-visual">
        <div class="skills-card cover-figure" data-cover-figure="help" role="img" aria-label={cover.helpFigure}></div>
      </div>
    </div>
  </div>
</div>

<div class="stop stop-cover is-hidden" data-cover="start" data-index="2" role="group" aria-label={cover.startLabel}>
  <div class="cover-shell">
    <div class="cover-grid">
      <div class="cover-copy">
        <p class="cover-eyebrow">{cover.startEyebrow}</p>
        <h2 class="cover-title">
          {cover.startTitle.map((line, index, lines) => (
            <Fragment>{index > 0 && ' '}<span
              class:list={['title-line', { 'title-accent': index === lines.length - 1 }]}
            >{line}</span></Fragment>
          ))}
        </h2>
        <p class="cover-lead">{cover.startLead}</p>
        <p class="cover-help">{cover.startNote}</p>
        <div class="cover-actions">
          <button class="primary-btn" id="startBtn" type="button">
            <span>{cover.startAction}</span>
            <span class="btn-orb" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h9M8.4 3.6 12.8 8l-4.4 4.4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
          </button>
        </div>
      </div>
      <div class="cover-visual">
        <div class="skills-card cover-figure" data-cover-figure="start" role="img" aria-label={cover.startFigure}></div>
      </div>
    </div>
  </div>
</div>
